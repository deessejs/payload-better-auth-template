{
  "name": "@template/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "payload:types": "payload generate:types --config ./payload.config.ts",
    "payload:migrate:create": "payload migrate:create --config ./payload.config.ts",
    "payload:migrate": "payload migrate --config ./payload.config.ts",
    "payload:migrate:status": "payload migrate:status --config ./payload.config.ts",
    "auth:migrate": "pnpm --filter @template/auth exec auth migrate --yes",
    "payload:importmap": "payload generate:importmap --config ./payload.config.ts",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "predev": "pnpm payload:importmap",
    "prebuild": "pnpm payload:importmap",
    "pretypecheck": "pnpm payload:importmap"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "catalog:",
    "@payloadcms/next": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@template/auth": "workspace:*",
    "@template/ui": "workspace:*",
    "better-auth": "catalog:",
    "next": "catalog:",
    "next-themes": "catalog:",
    "payload": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "sass": "^1.89.2",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
