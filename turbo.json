{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  },
  "globalEnv": ["DATABASE_URL", "PAYLOAD_SECRET", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL"]
}
